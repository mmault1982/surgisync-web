# Backend the Vite dev proxy forwards /api to.
VITE_PROXY_TARGET=http://localhost:8000

# A seeded, approved user for `pnpm test:e2e`.
E2E_EMAIL=
E2E_PASSWORD=

# Basemap for Kit Detail's Live Location panel. Both default to OpenStreetMap,
# whose tile policy is aimed at low-volume use — point these at a commercial
# host (MapTiler, Stadia, Carto) before this is in front of many organizations.
# Whatever you set, the attribution has to stay visible on the map.
# VITE_MAP_TILE_URL=
# VITE_MAP_TILE_ATTRIBUTION=
