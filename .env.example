# Backend the Vite dev proxy forwards /api to.
VITE_PROXY_TARGET=http://localhost:8000

# A seeded, approved user for `pnpm test:e2e`.
E2E_EMAIL=
E2E_PASSWORD=

# Basemap for Kit Detail's Live Location panel.
#
# With a key, the panel draws a Google Static Maps image; without one it falls
# back to Leaflet on OpenStreetMap, which costs nothing but whose tile policy
# rules it out for production. Leave this unset for ordinary local work.
#
# The key ships in the bundle — that is expected — so whichever key you use must
# be restricted in Cloud Console to the Maps Static API and to HTTP referrers,
# including http://localhost:5173/* if you want Google locally.
# VITE_GOOGLE_MAPS_API_KEY=
#
# The XYZ seam for the fallback, if a conventional tile host (MapTiler, Stadia,
# Carto) is ever wanted instead. Whatever you set, the attribution has to stay
# visible on the map.
# VITE_MAP_TILE_URL=
# VITE_MAP_TILE_ATTRIBUTION=
