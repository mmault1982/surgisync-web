{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],

    // No baseUrl: deprecated in TS 6, removed in TS 7. `paths` resolves
    // relative to this file, which is what we want anyway.
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "e2e", "*.config.ts", "scripts"],
  "exclude": ["node_modules", "dist"]
}
